# --- manuscripts and anything derived from them -------------------------------
# Unpublished research must never enter version control on a public remote.
# Keep source manuscripts outside the repo, or under a directory ignored here.
*.docx
*.doc
*.rtf
*.odt
*.pdf
manuscripts/
manuscript_done

# Run outputs contain the full bibliography and Zotero item keys
zot_out/
zot_out_*/
report*.csv
doi_list.txt

# --- local state --------------------------------------------------------------
database/
*.sqlite
*.sqlite3

# --- credentials --------------------------------------------------------------
.env
.env.*
*.key
zotero_credentials*
# Saved CLI credentials, if anyone ever points $ZOTPREP_CONFIG at the repo.
.zotprep/
config.json

# Claude Code's local settings record the exact commands that were approved,
# which for this project has included ones with ZOTERO_KEY=... typed inline.
# A global ignore rule already covers this file, but a global rule is not part
# of the repository and does not protect a fresh clone or a CI checkout.
.claude/settings.local.json
.claude/settings.local.*.json

# --- python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- parity fixtures ----------------------------------------------------------
# Generated by web/tools/parity/docx_fixture.py; rebuild rather than commit.
# (fixture.docx is already covered by the *.docx rule above.)
web/fixture.expect.json

# --- test scratch -------------------------------------------------------------
tests/r3.*
tests/r4.*
tests/run_35_out.json
tests/converted_cites.json
tests/verify_out.json

# --- editors / OS -------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
